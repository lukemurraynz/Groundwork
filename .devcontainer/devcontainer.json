{
  "name": "Groundwork Dev Container",

  // Language-specific base rather than the plain base image: Python 3.12 matches
  // pyproject.toml requires-python and the azurelinux/base/python:3.12 production
  // Dockerfiles in docker/. Ships git, common utilities, and the non-root `vscode` user.
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",

  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "privileged": false,
  "shutdownAction": "stopContainer",
  "init": true,

  "features": {
    // PD-004: azd delivers Groundwork itself, so it is a first-class dev tool here.
    // Official Azure-published feature, pinned to its 0.2 release line rather than
    // :latest. The azd CLI inside still tracks current stable at image-build time -
    // deliberate: azd ships weekly and nothing else in this repo pins an azd version.
    "ghcr.io/azure/azure-dev/azd:0.2": {},

    // Azure CLI + Bicep for the preprovision/postprovision azd hooks (scripts/) and
    // `az bicep build` against infra/. Version pinned for reproducibility;
    // verified against GHCR feature metadata and the Azure/azure-cli release feed.
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {
      "version": "2.89.1",
      "installBicep": true
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        // Linter/formatter driven by the [tool.ruff] config in pyproject.toml.
        "charliermarsh.ruff",
        // Bicep language support for infra/.
        "ms-azuretools.vscode-bicep"
      ]
    }
  },

  // Dependency restore lives here (not postCreate) so Codespaces prebuilds cache it.
  // --frozen honours uv.lock exactly, matching docker/*.Dockerfile. Installs the exact
  // uv version the production images pin. --all-extras mirrors how tests run locally:
  // they import across controlplane/orchestrator/channels/shared.
  // The explicit $HOME path sidesteps PATH differences between lifecycle shells.
  "updateContentCommand": "python3 -m pip install --quiet --user uv==0.11.14 && $HOME/.local/bin/uv sync --frozen --all-extras",

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // Control plane serves on 8080 (docker/controlplane.Dockerfile EXPOSE).
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Control plane API",
      "onAutoForward": "notify"
    }
  },
  "mounts": []
}
